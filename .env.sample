# =============================================================================
# DS4F-VE vllm0.29 B12X cluster — environment configuration
# Copy to .env (NOT committed) and adjust for your cluster.
# All values below feed the rendered `vllm serve` command in start-cluster.sh.
# =============================================================================

# --- eugr launcher stack ---
# Path to the spark-vllm-docker repo (contains launch-cluster.sh).
# Users point this at their own checkout of the eugr stack.
SPARK_VLLM_DOCKER_HOME=/path/to/spark-vllm-docker

# --- Cluster topology ---
# First = head (rank 0), rest = workers (rank 1..N). Use the RoCE/RDMA subnet
# for TP2 comm when available.
CLUSTER_NODES=192.168.0.1,192.168.0.2
SSH_USER=youruser

# --- Container / image ---
IMAGE=vllm_spark_dsv4:0.29-b12x
CONTAINER_NAME=vllm_node

# --- Checkpoint (both nodes) ---
# HF hub tree containing models--deepseek-ai--DeepSeek-V4-Flash-Vision-Exp
# (refs/main -> 6821d6ad, 48 safetensors shards). MUST be a complete tree:
# a partial cache (config+index, .incomplete blobs, no shard symlinks) makes
# the loader hang silently forever.
HF_CACHE_DIR=/path/to/models/deepseek-ai

# --- Serving parameters ---
MODEL=deepseek-ai/DeepSeek-V4-Flash-Vision-Exp
SERVED_MODEL_NAME=deepseek-v4-flash
PORT=8100
TENSOR_PARALLEL=2
GPU_MEMORY_UTIL=0.87          # GB10 ceiling is 0.877 (106.77/121.69 GiB free at boot); 0.9 CRASHES
KV_CACHE_DTYPE=fp8            # PLAIN fp8. fp8_ds_mla needs the patched gist stack
MAX_MODEL_LEN=1048576
BLOCK_SIZE=256
MAX_NUM_SEQS=8
MAX_NUM_BATCHED_TOKENS=2048
MAX_CUDAGRAPH_CAPTURE_SIZE=48
NUM_SPECULATIVE_TOKENS=3      # DSpark k — MUST be divisible by n_predict=3 (pydantic validator
                              # rejects 5: "must be divisible by n_predict=3"). Anemll floor was 6;
                              # upstream accepts 3 (PILCOTHINK reference).
DRAFT_SAMPLE_METHOD=probabilistic
REASONING_EFFORT=max

# --- Multimodal ---
LIMIT_MM_IMAGES=8             # image cap per prompt. skip-mm-profiling is mandatory.

# --- Health ---
READY_TIMEOUT_S=1500
