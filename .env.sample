# =============================================================================
# DS4F-VE vllm0.29 B12X cluster — environment configuration
# Copy to .env (NOT committed) and adjust for your cluster.
# All ${VAR} tokens in recipes/*.yaml.tmpl are rendered from this file by start.sh.
# =============================================================================

# --- spark-vllm-docker launcher location (operational repo, on the head node) ---
SPARK_VLLM_DOCKER=/home/xraan/spark-vllm-docker

# --- Cluster topology ---
# First = head (rank 0), rest = workers. Use the RoCE/RDMA subnet for TP2 comm.
CLUSTER_NODES=192.168.0.8,192.168.0.88
SSH_USER=xraan

# --- Container / image ---
IMAGE=vllm_spark_dsv4:0.29-b12x
CONTAINER_NAME=vllm_node

# --- Checkpoint (both nodes) ---
# HF hub tree with models--deepseek-ai--DeepSeek-V4-Flash-Vision-Exp
# (refs/main -> 6821d6ad). MUST NOT be the root-owned partial decoy in ~/.cache.
HF_CACHE_DIR=/home/xraan/models/deepseek-ai

# --- Serving parameters ---
MODEL=deepseek-ai/DeepSeek-V4-Flash-Vision-Exp
SERVED_MODEL_NAME=deepseek-v4-flash
PORT=8100
TENSOR_PARALLEL=2
GPU_MEMORY_UTIL=0.87          # GB10 ceiling is 0.877 (106.77/121.69 free at boot); 0.9 CRASHES
KV_CACHE_DTYPE=fp8            # PLAIN fp8. fp8_ds_mla needs the patched gist stack
MAX_MODEL_LEN=1048576
BLOCK_SIZE=256
MAX_NUM_SEQS=16
MAX_NUM_BATCHED_TOKENS=4096
MAX_CUDAGRAPH_CAPTURE_SIZE=48
NUM_SPECULATIVE_TOKENS=3      # DSpark k — MUST be divisible by n_predict=3 (pydantic validator
                              # rejects 5: "must be divisible by n_predict=3"). Anemll floor was 6;
                              # upstream accepts 3 (PILCOTHINK reference).
DRAFT_SAMPLE_METHOD=probabilistic
REASONING_EFFORT=max

# --- Multimodal ---
LIMIT_MM_IMAGES=8             # image cap per prompt. skip-mm-profiling is mandatory.

# --- Health ---
READY_TIMEOUT_S=1500
