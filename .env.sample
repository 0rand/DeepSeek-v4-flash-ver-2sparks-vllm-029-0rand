# =============================================================================
# DS4F-VE vllm0.29 B12X cluster — environment configuration
# Copy to .env (NOT committed) and adjust for your cluster.
# All values below feed the rendered `vllm serve` command in start-cluster.sh.
# =============================================================================

# --- eugr launcher stack ---
# Path to the spark-vllm-docker repo (contains launch-cluster.sh).
# Users point this at their own checkout of the eugr stack.
SPARK_VLLM_DOCKER_HOME=/path/to/spark-vllm-docker

# --- Cluster topology ---
# First = head (rank 0), rest = workers (rank 1..N). Use the RoCE/RDMA subnet
# for TP2 comm when available.
CLUSTER_NODES=192.168.0.1,192.168.0.2
SSH_USER=youruser

# --- Container / image ---
#IMAGE=vllm_spark_dsv4:0.29-b12x  # Retired as new features were added by PILCOTHINK and Dickson source-built it - use his image
IMAGE=dicksondickson/vllm_spark_dsv4:0.29-b12x 
CONTAINER_NAME=vllm_node

# --- Checkpoint (both nodes) ---
# HF hub tree containing models--deepseek-ai--DeepSeek-V4-Flash-Vision-Exp
# (refs/main -> 6821d6ad, 48 safetensors shards). MUST be a complete tree:
# a partial cache (config+index, .incomplete blobs, no shard symlinks) makes
# the loader hang silently forever.
HF_CACHE_DIR=/path/to/models/deepseek-ai

# --- Serving parameters ---
MODEL=deepseek-ai/DeepSeek-V4-Flash-Vision-Exp
SERVED_MODEL_NAME=deepseek-v4-flash
PORT=8100
TENSOR_PARALLEL=2
GPU_MEMORY_UTIL=0.87          # GB10 ceiling is 0.877 (106.77/121.69 GiB free at boot); 0.9 CRASHES 0.875 works in headless mode with under 4.5 GB RAM use before the load and 122GB available overall
KV_CACHE_DTYPE=fp8            # PLAIN fp8. fp8_ds_mla needs the patched gist stack
MAX_MODEL_LEN=1048576
BLOCK_SIZE=256
MAX_NUM_SEQS=4                # 16 works - up to 145-150 t/s on mixed context, set 16 if you need, give more batched tokens
MAX_NUM_BATCHED_TOKENS=4096   # Around 3M tokens cache, if max cache needed - stay with 1024, 4M cache
MAX_CUDAGRAPH_CAPTURE_SIZE=48 # 48 works for 8-16 seqs, disabling cudagraphs/enabling eager collapses speed 2x and not improving quality
NUM_SPECULATIVE_TOKENS=6      # DSpark k — MUST be divisible by n_predict=3 (pydantic validator
                              # rejects 5: "must be divisible by n_predict=3"). Anemll floor was 6;
                              # upstream accepts 3 (PILCOTHINK reference). >> 3 tokens damage quality and thinking -> stay with 6, speed loss to 3 is 5% only
DRAFT_SAMPLE_METHOD=probabilistic # setting up greedy does not help quality but hurts speed
REASONING_EFFORT=max

# --- Multimodal ---
LIMIT_MM_IMAGES=3             # image cap per prompt. skip-mm-profiling is mandatory to keep memory usage on boot sane. Cost - small delay on the first MM request to warm up

# --- Health ---
READY_TIMEOUT_S=1500

# --- Bugfix flag ---
# FIX_MM_PREFIX_SPAN=1 applies mods/fix-dsv4-mm-prefix-span (Python-only patch:
# wrong mm-prefix bidirectional span for DSV4 vision in V2 Model Runner, see
# INVESTIGATION-vision-grounding-bias.md §12.7) to every node at launch.
# NOTE: mods apply only when containers are (re)created — run
#   ./start-cluster.sh stop && ./start-cluster.sh start
# after flipping this flag (requires a restart window).
FIX_MM_PREFIX_SPAN=0
